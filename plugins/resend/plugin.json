  "author": {
    "name": "Everruns",
    "url": "https://everruns.com"
  },
  "homepage": "https://resend.com",
  "repository": "https://github.com/everruns/everruns",
  "license": "MIT",
  "keywords": ["email", "resend", "mcp", "oauth"],
  "extensions": {
    "com.everruns": {
      "mcpServers": {
        "resend": { "auth": "oauth" }
      }
    }
  }
}
