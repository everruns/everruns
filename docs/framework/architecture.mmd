flowchart TB
    F["Framework app<br/>everruns::Engine • Session<br/>durable feature: opt-in"]
    S["Platform server<br/>schedules turns<br/>persist → DurableRunner"]
    W["Platform worker<br/>claims steps over gRPC<br/>WorkerRuntimeHost"]

    B["everruns-core host<br/>TurnBackend<br/>start_turn • cancel • is_running"]

    I["InProcessBackend<br/>default, runs on the caller's task"]

    subgraph DE["everruns-durable-engine (experimental)"]
        DB["DurableBackend<br/>facade sessions, memory or PostgreSQL"]
        DR["DurableRunner<br/>stored input only, implements TurnBackend"]
        TD["TurnTaskDriver<br/>process_input • reason • act, checkpoint each step"]
    end

    K["core::engine<br/>Execution • TurnExecution<br/>Input / Reason / Act"]

    D["everruns-durable<br/>task queue • event log • signals • timers • child workflows<br/>worker registry • DLQ • circuit breakers • schedules • Workflow executor<br/>generic engine, no everruns-* dependencies"]

    M["In-memory store<br/>InMemoryWorkflowEventStore"]
    P["PostgreSQL store<br/>PostgresWorkflowEventStore"]

    F -->|"create / resume / send"| B
    S -->|"start_turn"| B
    B -->|"default"| I
    B -->|"durable backend"| DE
    W -->|"claims steps, gRPC TaskStore"| TD
    I -->|"drives each step"| K
    DE -.->|"same kernel"| K
    DE -->|"TaskStore / WorkflowEventStore"| D
    D --> M
    D --> P

