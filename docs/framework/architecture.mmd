flowchart TB
    F["Framework app<br/>everruns::Engine • Session<br/>sessions run as actors"]
    S["Platform server<br/>schedules turns<br/>persist → ActorTurnBackend"]
    W["Platform worker<br/>leases sessions over gRPC<br/>WorkerRuntimeHost"]

    B["everruns-core host<br/>TurnBackend<br/>start_turn • cancel • is_running"]

    I["ActorRunner<br/>in process, session lease<br/>InProcessBackend + lease"]

    subgraph DE["Platform, session actors (server + worker)"]
        SA["session_actors<br/>runnable, fenced lease<br/>postgres, via gRPC"]
        DR["ActorTurnBackend<br/>marks runnable, implements TurnBackend"]
        TD["actor_runtime<br/>one turn per lease<br/>drive_turn, resumed by folding the log"]
    end

    K["core::engine<br/>Execution • TurnExecution<br/>Input / Reason / Act"]

    D["everruns-durable<br/>task queue • event log • signals • worker pool<br/>worker registry • DLQ • circuit breakers • schedules<br/>generic engine, no everruns-* dependencies"]

    M["In-memory store<br/>InMemoryWorkflowEventStore"]
    P["PostgreSQL store<br/>PostgresWorkflowEventStore"]

    F -->|"create / resume / send"| B
    S -->|"start_turn"| B
    B -->|"default"| I
    B -->|"platform"| DE
    W -->|"leases sessions, gRPC lease store"| TD
    I -->|"drives the turn"| K
    DE -.->|"same kernel"| K
    DE -->|"TaskStore / WorkflowEventStore"| D
    D --> M
    D --> P

