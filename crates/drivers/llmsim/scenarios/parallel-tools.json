{
  "name": "parallel-tools",
  "description": "One step with 4 tool calls, then an answer: parallel tool execution.",
  "defaults": { "timing": { "ttft_ms": [800, 1300], "tokens_per_sec": 65 } },
  "steps": [
    { "turn": { "type": "tool_calls", "calls": [
