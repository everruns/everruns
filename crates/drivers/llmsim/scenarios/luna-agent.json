{
  "name": "luna-agent",
  "description": "A typical tool-using turn timed like GPT-6 Luna (first token about 2.9 s, 108 tokens/s): the file-research tool rounds (seed /load-test/research.md first), then a 100-500 token answer.",
  "defaults": {"timing": {"ttft_ms": [2000, 4500], "tokens_per_sec": 108}},
  "steps": [
    {"turn": {"type": "mixed", "lorem_tokens": [10, 30], "calls": [{"name": "list_directory", "arguments": {"path": "/load-test"}}]}},
    {"turn": {"type": "tool_calls", "calls": [{"name": "read_file", "arguments": {"path": "/load-test/research.md"}}]}},
    {"turn": {"type": "tool_calls", "calls": [{"name": "stat_file", "arguments": {"path": "/load-test/research.md"}}, {"name": "read_file", "arguments": {"path": "/load-test/research.md"}}]}},
    {"turn": {"type": "assistant", "lorem_tokens": [100, 500]}}
  ]
}
