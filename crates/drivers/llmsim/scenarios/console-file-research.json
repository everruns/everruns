{
  "name": "console-file-research",
  "description": "Three file-research rounds using read_file, which stays directly exposed on managed Platform Chat, then a 600-token answer. Seed /load-test/research.md first.",
  "defaults": { "timing": { "ttft_ms": [800, 1300], "tokens_per_sec": 65 } },
  "steps": [
    { "turn": { "type": "mixed", "text": "Let me inspect the research notes.",
                "calls": [{ "name": "read_file", "arguments": { "path": "/load-test/research.md", "offset": 0, "limit": 10, "human_intent": "Reading local research notes" } }] } },
    { "turn": { "type": "tool_calls", "calls": [{ "name": "read_file", "arguments": { "path": "/load-test/research.md", "offset": 10, "limit": 10, "human_intent": "Reading the next research section" } }] } },
    { "turn": { "type": "tool_calls", "calls": [
      { "name": "read_file", "arguments": { "path": "/load-test/research.md", "offset": 20, "limit": 10, "human_intent": "Checking research details" } },
      { "name": "read_file", "arguments": { "path": "/load-test/research.md", "offset": 30, "limit": 10, "human_intent": "Checking the final research section" } }
    ] } },
    { "turn": { "type": "assistant", "lorem_tokens": 600 } }
  ]
}
