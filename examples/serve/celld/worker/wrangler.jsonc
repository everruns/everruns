{
  "name":"serve-celld-engine",
  "main":"src/index.js",
  "build":{"command":"bash ../../../../crates/durable-object/worker/build-authority.sh"},
  "compatibility_date":"2026-09-01",
  "compatibility_flags":["nodejs_compat"],
  "vars":{"TENANT_ID":"example","CONTAINER_ENV":""},
  "containers":[{"class_name":"ServeExecutor","image":"serve-celld-example:latest","instance_type":"basic"}],
  "durable_objects":{"bindings":[
    {"name":"SESSIONS","class_name":"SessionAuthority"},
    {"name":"EXECUTORS","class_name":"ServeExecutor"}
  ]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["SessionAuthority","ServeExecutor"]}]
}
