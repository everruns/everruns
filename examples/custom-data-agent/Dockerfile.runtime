# Package a native binary already built for the selected runtime's libc.
# The full source-build Dockerfile remains the portable release-image path.
ARG RUNTIME_IMAGE=debian:trixie-slim
FROM ${RUNTIME_IMAGE}
RUN --mount=type=secret,id=system_ca \
    apt_options=""; if [ -f /run/secrets/system_ca ]; then apt_options="-o Acquire::https::CaInfo=/run/secrets/system_ca"; fi; \
    apt-get $apt_options update && apt-get $apt_options install -y --no-install-recommends ca-certificates libssl3t64 && rm -rf /var/lib/apt/lists/*
COPY everruns-custom-data-agent /usr/local/bin/custom-data-agent
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/custom-data-agent"]
