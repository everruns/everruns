{
  "name": "everruns-durable-chat",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ChatRoom" },
      { "name": "SESSIONS", "class_name": "ChatSession" },
    ],
  },
  // Preserve the deployed ChatRoom namespace. Retire the unused minimal agent
  // class from the first deployment; it is not part of this application's host.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentCell"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v3", "deleted_classes": ["AgentCell"] },
    { "tag": "v4", "new_sqlite_classes": ["ChatSession"] },
  ],
  "vars": {
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "MODEL": "meta/muse-spark-1.3-contributor",
    "TENANT_ID": "chat",
  },
}
