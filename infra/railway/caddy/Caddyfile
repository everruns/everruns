# Railway ingress for the Everruns template.
#
# The public Caddy service is the only internet-facing service. It preserves
# the production route contract from knowledge/operations/production-deployment.md while
# forwarding to server and UI over Railway private networking.

:{$PORT:8080} {
	handle /api/* {
		reverse_proxy {$SERVER_HOST}:9000 {
			flush_interval -1
		}
	}

	handle /oauth/* {
		reverse_proxy {$SERVER_HOST}:9000
	}

	handle /mcp {
		reverse_proxy {$SERVER_HOST}:9000
	}

	# Pages served under the MCP endpoint — the URL mode elicitation forms a
	# user opens out of band. Matched separately from /mcp so the UI's own
	# /mcp-servers route is not swallowed by a /mcp* prefix.
	handle /mcp/* {
		reverse_proxy {$SERVER_HOST}:9000
	}

	handle /.well-known/* {
		reverse_proxy {$SERVER_HOST}:9000
	}
	# Agent-facing documents, served by the API (see local/Caddyfile).
	@agent_docs path /auth.md /llms.txt /robots.txt /sitemap.xml
	handle @agent_docs {
		reverse_proxy {$SERVER_HOST}:9000
	}
	# The console at / needs JavaScript, so an agent that asks for markdown
	# there gets llms.txt, which says where the MCP endpoint and auth.md are.
	@agent_markdown {
		path /
		header Accept *text/markdown*
	}
	handle @agent_markdown {
		header Vary Accept
		rewrite * /llms.txt
		reverse_proxy {$SERVER_HOST}:9000
	}

	handle /api-doc/* {
		reverse_proxy {$SERVER_HOST}:9000
	}

	handle /cli/login-success {
		reverse_proxy {$SERVER_HOST}:9000
	}

	handle /health {
		reverse_proxy {$SERVER_HOST}:9000
	}

	handle {
		# Point agents at the discovery documents (RFC 8288, RFC 9727).
		header / +Link "</.well-known/api-catalog>; rel=\"api-catalog\", </llms.txt>; rel=\"describedby\"; type=\"text/markdown\", </auth.md>; rel=\"service-doc\"; type=\"text/markdown\", </api-doc/openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\""
		header / +Vary Accept
		reverse_proxy {$UI_HOST}:9100
	}
}
