+/** Converts rendered HTML to the same Markdown format as content collection entries. */
+export async function htmlToSimpleMarkdown(
+	html: string,
+	context: APIContext,
+	contentSelector?: string,
+): Promise<string> {
+	const file = await htmlToMarkdownPipeline.process({
+		value: html,
+		data: {
+			starlightLlmsTxt: {
+				contentSelector,
+				minify: false,
+				site: context.site?.href,
+			},
+		},
+	});
+	return String(file).trim();
+}
