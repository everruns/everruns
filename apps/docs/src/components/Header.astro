---
import DefaultHeader from "@astrojs/starlight/components/Header.astro";

const sidebarTopics = Astro.locals.starlightSidebarTopics;
const topics = sidebarTopics?.topics ?? [];
const hasTopics = topics.length > 0;
---

<DefaultHeader {...Astro.props} />

{hasTopics && (
  <div class="topic-tabs-wrapper">
    <nav class="topic-tabs" aria-label="Documentation sections">
      <ul>
        {topics.map((topic: any) => (
          <li>
            <a
              href={topic.link}
              class:list={{ active: topic.isCurrent }}
              aria-current={topic.isCurrent ? "true" : undefined}
            >
              {topic.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<style>
  .topic-tabs-wrapper {
    position: fixed;
    top: var(--sl-nav-height);
    left: 0;
    right: 0;
    z-index: var(--sl-z-index-navbar);
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  .topic-tabs ul {
    display: flex;
    list-style: none;
    padding: 0 var(--sl-nav-pad-x);
    margin: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .topic-tabs ul::-webkit-scrollbar {
    display: none;
  }

  .topic-tabs a {
    display: block;
    padding: 0.5rem 1rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .topic-tabs a:hover {
    color: var(--sl-color-white);
  }

  .topic-tabs a.active {
    color: var(--sl-color-text-accent);
    border-bottom-color: var(--sl-color-text-accent);
  }

  /* Hide on mobile — sidebar topics used there instead */
  @media (max-width: 49.99rem) {
    .topic-tabs-wrapper {
      display: none;
    }
  }
</style>
