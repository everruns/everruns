---
// The docs bar: the sticky row under the everruns.com site header (see
// PageFrame.astro). "Docs", the section tabs, search, the theme switch, and an
// Open Cloud button. When the site header scrolls out of view the bar gets
// data-compact, and the logo and Open Cloud slide in (docs-layout.css), so
// the bar alone still says which site this is.
import { docsPath } from "../lib/site";
import Search from "./Search.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import logo from "../assets/logo.svg?url";

const sidebarTopics = Astro.locals.starlightSidebarTopics;
const topics = sidebarTopics?.topics ?? [];
const currentPath = Astro.url.pathname;
const API = docsPath("/api/");
const isTopicActive = (topic: any) =>
  topic.isCurrent || (topic.link === API && currentPath.startsWith(API));
---

<a class="er-bar-home" href={docsPath("/")}>
  <span class="er-bar-logo" aria-hidden="true"><img src={logo} alt="" width="20" height="20" /></span>
  <span class="er-bar-wordmark">Docs</span>
</a>
<span class="er-bar-divider" aria-hidden="true"></span>
{
  topics.length > 0 && (
    <nav class="er-bar-tabs" aria-label="Documentation sections">
      {topics.map((topic: any) => (
        <a
          href={topic.link}
          class:list={{ active: isTopicActive(topic) }}
          aria-current={isTopicActive(topic) ? "true" : undefined}
        >
          {topic.label}
        </a>
      ))}
    </nav>
  )
}
<div class="er-bar-tools print:hidden">
  <Search />
  <ThemeSwitch />
  <span class="er-bar-cta">
    <a href="https://app.everruns.com" tabindex="-1" data-er-bar-cta>Open Cloud</a>
  </span>
</div>

<script>
  // Open Cloud is only reachable by keyboard once it is visible.
  const bar = document.querySelector<HTMLElement>("[data-er-docs-bar]");
  const cta = document.querySelector<HTMLElement>("[data-er-bar-cta]");
  if (bar && cta) {
    const sync = () => {
      const shown = bar.hasAttribute("data-compact");
      cta.tabIndex = shown ? 0 : -1;
      cta.toggleAttribute("aria-hidden", !shown);
    };
    sync();
    new MutationObserver(sync).observe(bar, { attributeFilter: ["data-compact"] });
  }
</script>
