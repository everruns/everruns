---
import { docsPath } from "../lib/site";
// Article head: breadcrumb, title, the description as a lede, a meta row
// (reading time, last updated, edit link), then the "Applies to" row.
//
// The docs home renders its own masthead (DocsHome.astro), so it gets no
// title here.
//
// Decision: the row reads the `appliesTo` frontmatter field (see
// src/content.config.ts) and lists all three ways of running Everruns, marking
// the ones the page does not apply to, so a reader can answer "does this work
// for me?" without reading the page. Pages without the field render no row:
// availability is filled in only where it was checked against the code.
import Default from "@astrojs/starlight/components/PageTitle.astro";
import ChangelogMeta from "./ChangelogMeta.astro";
import { isChangelogEntry } from "../lib/changelog";

const entry = Astro.locals.starlightRoute.entry;

const route = Astro.locals.starlightRoute;
const appliesTo: string[] | undefined = entry.data.appliesTo;
// The home and 404 pages draw their own heading (DocsHome, NotFound).
const isHome = entry.id === "index" || entry.id === "" || entry.id === "404";

const topic = Astro.locals.starlightSidebarTopics?.topics?.find((t: any) => t.isCurrent);
const title = entry.data.title;
// The section's own landing page is its breadcrumb's last item already.
const crumbs = [
  { label: "Docs", href: docsPath("/") },
  ...(topic && topic.label !== title ? [{ label: topic.label, href: topic.link }] : []),
];
const description = isChangelogEntry(entry) ? undefined : entry.data.description;
// About 200 words a minute; code counts as words, which suits docs.
const words = typeof entry.body === "string" ? entry.body.split(/\s+/).filter(Boolean).length : 0;
const minutes = words > 0 ? Math.max(1, Math.round(words / 200)) : 0;
const { lastUpdated, editUrl, lang } = route;
// Changelog lists (the index and each product page) carry their RSS feed in
// the title row; entries and the feeds page do not.
const changelogList = /^changelog(\/[a-z]+)?$/.test(entry.id.replace(/\/index$/, "")) && !isChangelogEntry(entry) && entry.id !== "changelog/feeds";
const feed = changelogList ? docsPath(`/${entry.id.replace(/\/index$/, "")}/rss.xml`) : undefined;

// Same order and names as the Start here chooser.
const targets = [
  { id: "framework", label: "Framework", href: docsPath("/framework/quickstart/") },
  { id: "platform", label: "Self-hosted", href: docsPath("/getting-started/docker-compose/") },
  { id: "cloud", label: "Everruns Cloud", href: docsPath("/getting-started/cloud/") },
];
---

{
  !isHome && (
    <nav class="er-breadcrumb" aria-label="Breadcrumb">
      {crumbs.map((crumb) => (
        <>
          <a href={crumb.href}>{crumb.label}</a>
          <span aria-hidden="true">/</span>
        </>
      ))}
      <span aria-current="page">{title}</span>
    </nav>
  )
}

{
  !isHome && feed ? (
    <div class="er-title-row">
      <Default />
      <a class="er-title-feed" href={feed} title="RSS feed">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
        RSS
      </a>
    </div>
  ) : (
    !isHome && <Default />
  )
}

{!isHome && description && <p class="er-lede">{description}</p>}

{isChangelogEntry(entry) && <ChangelogMeta entry={entry} />}

{
  // A changelog list is a feed, not an article: no reading time or edit link,
  // and no meta rule pressed against its filter bar.
  !isHome && !feed && (minutes > 0 || lastUpdated || editUrl) && (
    <p class="er-page-meta">
      {minutes > 0 && <span>{minutes} min read</span>}
      {lastUpdated && (
        <span>
          Updated{" "}
          <time datetime={lastUpdated.toISOString()}>
            {lastUpdated.toLocaleDateString(lang, { dateStyle: "medium", timeZone: "UTC" })}
          </time>
        </span>
      )}
      {editUrl && (
        <a class="print:hidden" href={editUrl}>
          Edit on GitHub
        </a>
      )}
    </p>
  )
}

{
  appliesTo && appliesTo.length > 0 && (
    <p class="applies-to">
      <a class="applies-to-label" href={docsPath("/getting-started/introduction/")}>
        Applies to
      </a>
      {targets.map((target) => {
        const on = appliesTo.includes(target.id);
        return (
          <a
            class:list={["applies-to-badge", { off: !on }]}
            href={target.href}
          >
            {target.label}
            {!on && <span class="sr-only"> (not available)</span>}
          </a>
        );
      })}
    </p>
  )
}

<style>
  .er-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 16px;
  }

  .er-title-row :global(h1) {
    margin: 0;
  }

  .er-title-feed {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .er-title-feed:hover {
    color: var(--sl-color-white);
  }

  .er-title-feed svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: #f26522;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .er-title-feed svg circle {
    fill: #f26522;
  }

  .applies-to {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    font-size: var(--sl-text-xs);
  }

  .applies-to-label {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    margin-inline-end: 0.25rem;
  }

  .applies-to-badge {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  .applies-to-badge.off {
    border-color: var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-4);
    text-decoration: line-through;
  }

  .applies-to a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
