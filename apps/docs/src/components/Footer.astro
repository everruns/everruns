---
import { docsPath } from "../lib/site";
import Pagination from "./Pagination.astro";
import { isChangelogEntry, productLabel, prLink } from "../lib/changelog";

// The end of the article: previous and next pages. The edit link and last
// updated date sit in the meta row under the title (PageTitle.astro), and the
// everruns.com site footer spans the page below the column (PageFrame.astro).
// A changelog entry closes with its pull requests and the products it is
// about, so a reader can go from "what changed" to the code and the product.
const PRODUCT_HOME: Record<string, string> = {
  cloud: "/getting-started/cloud/",
  platform: "/getting-started/docker-compose/",
  framework: "/framework/quickstart/",
  sdk: "https://github.com/everruns/sdk",
  cli: "/reference/cli/",
  yolop: "https://github.com/everruns/yolop",
  mira: "https://github.com/everruns/mira",
  bashkit: "https://bashkit.sh",
};
const entry = Astro.locals.starlightRoute.entry;
const links = isChangelogEntry(entry)
  ? (entry.data.products ?? []).map((p: string) => ({ label: productLabel(p), href: docsPath(PRODUCT_HOME[p]) }))
  : [];
const prs = isChangelogEntry(entry) ? (entry.data.links?.prs ?? []).map(prLink) : [];
---

{prs.length > 0 && (
<p class="changelog-prs">
  <span>Pull requests</span>
  {prs.map((pr) => <a href={pr.href} rel="noopener">{pr.label}</a>)}
</p>
)}

{links.length > 0 && (
<div class="site-footer-links">
  <nav aria-label="Everruns sites">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel={link.href.startsWith("http") ? "noopener" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
)}

<Pagination />

<style>
  .changelog-prs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-block-start: 2.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .changelog-prs a {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-text-accent);
  }

  .changelog-prs + .site-footer-links {
    margin-block-start: 1rem;
  }

  .site-footer-links {
    margin-block-start: 3rem;
    padding-block-end: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  .site-footer-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer-links a {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .site-footer-links a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
