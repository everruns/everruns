---
import { docsPath } from "../lib/site";
import DefaultFooter from "@astrojs/starlight/components/Footer.astro";
import { isChangelogEntry, productLabel } from "../lib/changelog";
import siteFooter from "../site-chrome/footer.html?raw";

// Every page ends with the everruns.com site footer, shared with the landing
// site (see Header.astro). A changelog entry also links the products it is
// about: where each one lives, so a reader can go from "what changed" to the
// product itself.
const PRODUCT_HOME: Record<string, string> = {
  cloud: "/getting-started/cloud/",
  platform: "/getting-started/docker-compose/",
  framework: "/framework/quickstart/",
  sdk: "https://github.com/everruns/sdk",
  cli: "/reference/cli/",
  yolop: "https://github.com/everruns/yolop",
  mira: "https://github.com/everruns/mira",
  bashkit: "https://bashkit.sh",
};
const entry = Astro.locals.starlightRoute.entry;
const links = isChangelogEntry(entry)
  ? (entry.data.products ?? []).map((p: string) => ({ label: productLabel(p), href: docsPath(PRODUCT_HOME[p]) }))
  : [];
---

{links.length > 0 && (
<div class="site-footer-links">
  <nav aria-label="Everruns sites">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel={link.href.startsWith("http") ? "noopener" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
)}

<DefaultFooter {...Astro.props} />

<div class="site-footer">
  <Fragment set:html={siteFooter} />
</div>

<style>
  .site-footer {
    margin-block-start: 3rem;
  }

  .site-footer :global(.er-footer) {
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  .site-footer-links {
    margin-block-end: 1rem;
    padding-block-end: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  .site-footer-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer-links a {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .site-footer-links a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
