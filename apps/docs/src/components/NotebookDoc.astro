---
import { readFileSync } from "node:fs";
import path from "node:path";
import { findNotebookEntry, normalizeNotebookRoute } from "./notebook-manifest";

interface Props {
  source?: string;
  route?: string;
}

const { source, route } = Astro.props;
const normalizedRoute = normalizeNotebookRoute(route ?? Astro.url.pathname);
const entry = findNotebookEntry({ source, route: normalizedRoute });

if (!entry) {
  throw new Error(
    source
      ? `Notebook manifest entry not found for source: ${source}`
      : `Notebook manifest entry not found for route: ${normalizedRoute}`
  );
}

const renderedHtml = readFileSync(
  path.join(process.cwd(), "src/generated/notebooks", entry.htmlFile),
  "utf8"
);
---

<div set:html={renderedHtml} />
