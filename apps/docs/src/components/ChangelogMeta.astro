---
// Header for one changelog entry, under its title: date, products and kind,
// where the change is available today, and its links. A superseded entry keeps
// its text and opens with a pointer to what replaced it.
import { getEntry } from "astro:content";
import {
  availability,
  formatDate,
  isoDate,
  prLink,
  surfaceLabel,
  type Entry,
} from "../lib/changelog";
import ChangelogTags from "./ChangelogTags.astro";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const d = entry.data;
const where = availability(entry);
const successor = d.supersededBy
  ? await getEntry("docs", `changelog/${d.supersededBy}`)
  : undefined;
// Docs links show the linked page's title; external links keep a generic label.
const docs = await Promise.all(
  (d.links?.docs ?? []).map(async (href) => {
    if (!href.startsWith("/")) return { href, label: "Docs" };
    const id = href.replace(/#.*$/, "").replace(/^\/|\/$/g, "");
    const page = await Promise.resolve(getEntry("docs", id)).catch(() => undefined);
    return { href, label: page?.data.title ?? "Docs" };
  }),
);
const prs = (d.links?.prs ?? []).map(prLink);
---

{
  (d.supersededBy || d.removedIn) && (
    <p class="changelog-superseded">
      {successor ? (
        <>
          Superseded by <a href={`/changelog/${d.supersededBy}/`}>{successor.data.title}</a>.
        </>
      ) : (
        <>Removed in {d.removedIn}.</>
      )}{" "}
      This entry describes the change as it shipped.
    </p>
  )
}

<div class="changelog-meta">
  <p class="changelog-meta-row">
    <a href="/changelog/">Changelog</a>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(d.date!)}>{formatDate(d.date!)}</time>
  </p>
  <p class="changelog-meta-row">
    <ChangelogTags kind={d.kind} significance={d.significance} products={d.products} />
    {(d.surfaces ?? []).length > 0 && (
      <span class="changelog-surfaces">{(d.surfaces ?? []).map(surfaceLabel).join(", ")}</span>
    )}
  </p>
  {
    where.length > 0 && (
      <p class="changelog-meta-row changelog-availability">
        {where.map((item) =>
          item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>,
        )}
      </p>
    )
  }
  {
    (docs.length > 0 || prs.length > 0) && (
      <p class="changelog-meta-row changelog-links">
        {docs.map((doc) => (
          <a href={doc.href}>{doc.label}</a>
        ))}
        {prs.map((pr) => (
          <a href={pr.href}>{pr.label}</a>
        ))}
      </p>
    )
  }
</div>

<style>
  .changelog-meta {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
  }

  .changelog-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin: 0.375rem 0 0;
    color: var(--sl-color-gray-3);
  }

  .changelog-meta-row a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .changelog-meta-row a:hover {
    text-decoration: underline;
  }

  .changelog-surfaces {
    font-size: var(--sl-text-xs);
  }

  .changelog-availability > * + *::before,
  .changelog-links > * + *::before {
    content: "·";
    margin-inline-end: 0.5rem;
    color: var(--sl-color-gray-4);
  }

  .changelog-availability a,
  .changelog-links a {
    color: var(--sl-color-text-accent);
  }

  .changelog-superseded {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.25rem;
    background: var(--sl-color-orange-low);
    font-size: var(--sl-text-sm);
  }
</style>
