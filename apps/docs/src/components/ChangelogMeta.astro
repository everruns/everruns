---
import { docsPath } from "../lib/site";
// Header for one changelog entry, under its title: date, products and kind,
// and where the change is available today. Docs links live in the entry's own
// text (knowledge/docs/changelog.md), and pull requests close the entry
// (Footer.astro). A superseded entry keeps its text and opens with a pointer
// to what replaced it.
import { getEntry } from "astro:content";
import {
  availability,
  formatDate,
  isoDate,
  surfaceLabel,
  type Entry,
} from "../lib/changelog";
import ChangelogTags from "./ChangelogTags.astro";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const d = entry.data;
const where = availability(entry);
const successor = d.supersededBy
  ? await getEntry("docs", `changelog/${d.supersededBy}`)
  : undefined;
---

{
  (d.supersededBy || d.removedIn) && (
    <p class="changelog-superseded">
      {successor ? (
        <>
          Superseded by <a href={docsPath(`/changelog/${d.supersededBy}/`)}>{successor.data.title}</a>.
        </>
      ) : (
        <>Removed in {d.removedIn}.</>
      )}{" "}
      This entry describes the change as it shipped.
    </p>
  )
}

<div class="changelog-meta">
  <p class="changelog-meta-row">
    <a href={docsPath("/changelog/")}>Changelog</a>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(d.date!)}>{formatDate(d.date!)}</time>
  </p>
  <p class="changelog-meta-row">
    <ChangelogTags kind={d.kind} significance={d.significance} products={d.products} />
    {(d.surfaces ?? []).length > 0 && (
      <span class="changelog-surfaces">{(d.surfaces ?? []).map(surfaceLabel).join(", ")}</span>
    )}
  </p>
  {
    where.length > 0 && (
      <p class="changelog-meta-row changelog-availability">
        {where.map((item) =>
          item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>,
        )}
      </p>
    )
  }
</div>

<style>
  .changelog-meta {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
  }

  .changelog-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin: 0.375rem 0 0;
    color: var(--sl-color-gray-3);
  }

  .changelog-meta-row a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .changelog-meta-row a:hover {
    text-decoration: underline;
  }

  .changelog-surfaces {
    font-size: var(--sl-text-xs);
  }

  .changelog-availability > * + *::before {
    content: "·";
    margin-inline-end: 0.5rem;
    color: var(--sl-color-gray-4);
  }

  .changelog-availability a {
    color: var(--sl-color-text-accent);
  }

  .changelog-superseded {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.25rem;
    background: var(--sl-color-orange-low);
    font-size: var(--sl-text-sm);
  }
</style>
