---
// The changelog list: every entry newest first, grouped by month, with filters
// for product, surface, significance and kind.
//
// Decision: filtering runs in the browser over a fully rendered list and keeps
// its state in the query string (`?product=yolop&significance=major`), so a
// filtered view is a shareable link and the page still works without
// JavaScript. Per-product pages (/changelog/<product>/) pass `product` and get
// the same list pre-filtered at build time, which is what feeds and search
// engines see. Superseded entries stay in the list with a Superseded tag.
import {
  KINDS,
  PRODUCTS,
  SIGNIFICANCE,
  SURFACES,
  entryUrl,
  formatDate,
  getChangelogEntries,
  isoDate,
} from "../lib/changelog";
import ChangelogTags from "./ChangelogTags.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  product?: string;
}

const { product } = Astro.props;
const all = await getChangelogEntries();
const entries = product ? all.filter((e) => (e.data.products as string[] | undefined)?.includes(product)) : all;

const months = new Map<string, typeof entries>();
for (const entry of entries) {
  const key = entry.data.date!.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
  });
  months.set(key, [...(months.get(key) ?? []), entry]);
}

// The list shows each entry's first image or video poster, so visuals are seen
// without opening the entry. Media is co-located in the entry folder.
const media = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../docs/changelog/*/*@2x.png",
  { eager: true },
);
const firstVisual = (entry: (typeof entries)[number]) => {
  const body = entry.body ?? "";
  const match =
    body.match(/!\[([^\]]*)\]\(\.\/([^)\s]+@2x\.png)\)/) ??
    body.match(/poster="\.\/([^"]+@2x\.png)"[^>]*aria-label="([^"]*)"/);
  if (!match) return undefined;
  const [file, alt] = match[0].startsWith("!") ? [match[2], match[1]] : [match[1], match[2]];
  const folder = entry.id.replace(/^changelog\//, "");
  const image = media[`../../../../docs/changelog/${folder}/${file}`]?.default;
  return image ? { image, alt } : undefined;
};

// Entries of one day share a single date, as on Vercel's changelog.
const days = (items: typeof entries) => {
  const byDay = new Map<string, typeof entries>();
  for (const entry of items) {
    const key = isoDate(entry.data.date!);
    byDay.set(key, [...(byDay.get(key) ?? []), entry]);
  }
  return [...byDay];
};

const feed = product ? `/changelog/${product}/rss.xml` : "/changelog/rss.xml";
const filters = [
  ...(product ? [] : [{ name: "product", label: "Product", options: PRODUCTS }]),
  { name: "surface", label: "Surface", options: SURFACES },
  { name: "significance", label: "Significance", options: SIGNIFICANCE },
  { name: "kind", label: "Category", options: KINDS },
];
---

<div class="changelog not-content" data-pagefind-ignore>
  <form class="changelog-filters" aria-label="Filter changes">
    {
      filters.map((filter) => (
        <label>
          <span>{filter.label}</span>
          <select name={filter.name}>
            <option value="">All</option>
            {filter.options.map((option) => (
              <option value={option.id}>{option.label}</option>
            ))}
          </select>
        </label>
      ))
    }
    <a class="changelog-feed" href={feed}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 11a9 9 0 0 1 9 9" />
        <path d="M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1" />
      </svg>
      RSS feed
    </a>
  </form>
  <p class="changelog-status" aria-live="polite" hidden></p>

  {
    [...months].map(([month, items]) => (
      <section class="changelog-month">
        <h2>{month}</h2>
        <ol>
          {days(items).map(([day, dayItems]) => (
            <li class="changelog-day">
              <time datetime={day}>{formatDate(dayItems[0].data.date!)}</time>
              <ol>
                {dayItems.map((entry) => {
                  const d = entry.data;
                  return (
                    <li
                      class="changelog-item"
                      data-product={(d.products ?? []).join(" ")}
                      data-surface={(d.surfaces ?? []).join(" ")}
                      data-significance={d.significance ?? ""}
                      data-kind={d.kind ?? ""}
                      data-release={d.release ?? ""}
                    >
                      <p class="changelog-tags">
                        <ChangelogTags kind={d.kind} significance={d.significance} products={d.products} />
                        {(d.supersededBy || d.removedIn) && (
                          <span class="changelog-superseded-tag">{d.removedIn ? "Removed" : "Superseded"}</span>
                        )}
                      </p>
                      <h3>
                        <a class="changelog-title" href={entryUrl(entry)}>{d.title}</a>
                      </h3>
                      {d.description && <p class="changelog-summary">{d.description}</p>}
                      {(() => {
                        const visual = firstVisual(entry);
                        return (
                          visual && (
                            <a class="changelog-visual" href={entryUrl(entry)} tabindex="-1">
                              <Image src={visual.image} alt={visual.alt} widths={[800, 1600]} sizes="(max-width: 50rem) 100vw, 40rem" />
                            </a>
                          )
                        );
                      })()}
                    </li>
                  );
                })}
              </ol>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
  {entries.length === 0 && <p>No changes yet.</p>}
</div>

<script>
  const root = document.querySelector<HTMLElement>(".changelog");
  const form = root?.querySelector<HTMLFormElement>(".changelog-filters");
  const status = root?.querySelector<HTMLElement>(".changelog-status");

  // Numeric compare of "X.Y.Z" versions; unreleased entries sort after all.
  const newer = (release: string, since: string) => {
    if (!release) return true;
    const a = release.split(".").map(Number);
    const b = since.split(".").map(Number);
    for (let i = 0; i < 3; i++) {
      if ((a[i] ?? 0) !== (b[i] ?? 0)) return (a[i] ?? 0) > (b[i] ?? 0);
    }
    return false;
  };

  function apply() {
    if (!root || !form) return;
    const params = new URLSearchParams(location.search);
    const since = params.get("since") ?? "";
    let shown = 0;
    for (const item of root.querySelectorAll<HTMLElement>(".changelog-item")) {
      let visible = true;
      for (const name of ["product", "surface", "significance", "kind"]) {
        const want = params.get(name);
        const have = (item.dataset[name] ?? "").split(" ");
        if (want && !have.includes(want)) visible = false;
      }
      if (since && !newer(item.dataset.release ?? "", since)) visible = false;
      item.hidden = !visible;
      if (visible) shown++;
    }
    for (const day of root.querySelectorAll<HTMLElement>(".changelog-day")) {
      day.hidden = !day.querySelector(".changelog-item:not([hidden])");
    }
    for (const month of root.querySelectorAll<HTMLElement>(".changelog-month")) {
      month.hidden = !month.querySelector(".changelog-item:not([hidden])");
    }
    if (status) {
      status.hidden = !since;
      status.textContent = since ? `${shown} changes since ${since}.` : "";
    }
  }

  if (form) {
    const params = new URLSearchParams(location.search);
    for (const field of form.querySelectorAll<HTMLSelectElement>("select")) {
      const value = params.get(field.name);
      if (value) field.value = value;
    }
    form.addEventListener("change", () => {
      const next = new URLSearchParams(location.search);
      for (const field of form.querySelectorAll<HTMLSelectElement>("select")) {
        const value = field.value;
        if (value) next.set(field.name, value);
        else next.delete(field.name);
      }
      const query = next.toString();
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
      apply();
    });
    form.addEventListener("submit", (event) => event.preventDefault());
    apply();
  }
</script>

<style>
  .changelog-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
  }

  .changelog-filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--sl-color-gray-3);
  }

  .changelog-filters select {
    min-width: 9rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
  }

  a.changelog-feed.changelog-feed {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-inline-start: auto;
    text-decoration: none;
    padding-bottom: 0.4rem;
    color: var(--sl-color-text-accent);
  }

  .changelog-feed svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: #f26522;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .changelog-superseded-tag {
    padding: 0.1rem 0.5rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }

  .changelog-status {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .changelog-month h2 {
    margin: 2rem 0 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .changelog-month ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .changelog-day {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .changelog-day > ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .changelog-visual {
    display: block;
    margin-top: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
  }

  .changelog-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  .changelog-item + .changelog-item {
    margin-top: 1.5rem;
  }

  .changelog-item[hidden],
  .changelog-day[hidden],
  .changelog-month[hidden] {
    display: none;
  }

  .changelog-day > time {
    position: sticky;
    top: calc(var(--sl-nav-height, 4rem) + 1rem);
    align-self: start;
    padding-top: 0.15rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .changelog-item h3 {
    margin: 0.25rem 0;
    font-size: var(--sl-text-lg);
    line-height: 1.35;
  }

  .changelog-item h3 a.changelog-title {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .changelog-item h3 a.changelog-title:hover {
    color: var(--sl-color-text-accent);
  }

  .changelog-summary {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .changelog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 50rem) {
    .changelog-day {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .changelog-day > time {
      position: static;
    }
  }
</style>
