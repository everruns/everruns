---
// Tags for one changelog entry: its kind with an icon and color, a Major mark,
// and its products as links to their changelog pages.
//
// Decision: color carries the kind (blue feature, green improvement, amber fix,
// red breaking or incident, purple release), using Starlight's paired color
// tokens so both themes keep contrast. Products stay neutral with their own
// logo, so a row never shows more than one or two strong colors.
import { kindLabel, productLabel, significanceLabel } from "../lib/changelog";
import { ICONS } from "../lib/changelog-icons";
import everrunsMark from "../assets/changelog/products/everruns.svg?raw";
import yolopMark from "../assets/changelog/products/yolop.svg?raw";
import bashkitMark from "../assets/changelog/products/bashkit.svg?raw";
import miraMark from "../assets/changelog/products/mira.svg?raw";

interface Props {
  kind?: string;
  significance?: string;
  products?: string[];
}

const { kind, significance, products = [] } = Astro.props;

// Product marks from each product's repository logo. Everruns-family products
// (Cloud, Platform, Framework, SDK, CLI) share the Everruns mark. Dark ink is
// swapped for currentColor so the marks follow the theme.
const MARKS: Record<string, string> = { yolop: yolopMark, bashkit: bashkitMark, mira: miraMark };
const mark = (id: string) =>
  (MARKS[id] ?? everrunsMark).replace(/#0A0A0A|#0A1636/gi, "currentColor").replace("<svg ", '<svg aria-hidden="true" ');

---

{
  kind && (
    <span class:list={["cl-tag", "cl-kind", `cl-${kind}`]}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {(ICONS[kind] ?? []).map((d) => <path d={d} />)}
      </svg>
      {kindLabel(kind)}
    </span>
  )
}
{
  significance === "major" && (
    <span class="cl-tag cl-kind cl-major">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {ICONS.major.map((d) => <path d={d} />)}
      </svg>
      {significanceLabel("major")}
    </span>
  )
}
{
  products.map((p) => (
    <a class:list={["cl-tag", "cl-product", `cl-p-${p}`]} href={`/changelog/${p}/`}>
      <Fragment set:html={mark(p)} />
      {productLabel(p)}
    </a>
  ))
}

<style>
  .cl-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    height: 1.4rem;
    padding: 0 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1;
    white-space: nowrap;
  }

  /* custom.css underlines `.sl-markdown-content a`; tags are chips, not prose
     links. Doubled class outranks it, since Astro scopes with zero specificity. */
  a.cl-tag.cl-tag,
  a.cl-tag.cl-tag:hover {
    text-decoration: none;
  }

  .cl-tag :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    flex: none;
  }

  .cl-kind svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Kind carries the color: tinted fill, colored line and ink. */
  .cl-kind {
    --cl: var(--sl-color-gray-3);
    --cl-ink: var(--sl-color-gray-2);
    border-color: color-mix(in srgb, var(--cl) 45%, transparent);
    background: color-mix(in srgb, var(--cl) 10%, transparent);
    color: var(--cl-ink);
    font-weight: 500;
  }
  .cl-feature { --cl: var(--sl-color-blue); --cl-ink: var(--sl-color-blue-high); }
  .cl-improvement { --cl: var(--sl-color-green); --cl-ink: var(--sl-color-green-high); }
  .cl-fix,
  .cl-deprecation { --cl: var(--sl-color-orange); --cl-ink: var(--sl-color-orange-high); }
  .cl-breaking,
  .cl-incident { --cl: var(--sl-color-red); --cl-ink: var(--sl-color-red-high); }
  .cl-release { --cl: var(--sl-color-purple); --cl-ink: var(--sl-color-purple-high); }
  .cl-major {
    --cl: #d4a43a;
    --cl-ink: #8a6414;
    font-weight: 600;
  }
:global([data-theme="dark"]) .cl-major {
    --cl-ink: #e5c06a;
  }
  .cl-major svg {
    fill: currentColor;
  }

  /* Products stay neutral, marked by the product's own logo. */
  .cl-product {
    padding-inline-start: 0.375rem;
    background: var(--sl-color-bg);
  }
  .cl-product:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
</style>
