---
// Tags for one changelog entry: its kind with an icon and color, a Major mark,
// and its products as links to their changelog pages.
//
// Decision: color carries the kind (blue feature, green improvement, amber fix,
// red breaking or incident, purple release), using Starlight's paired color
// tokens so both themes keep contrast. Products stay neutral with a small
// colored dot, so a row never shows more than one or two strong colors.
import { kindLabel, productLabel, significanceLabel } from "../lib/changelog";

interface Props {
  kind?: string;
  significance?: string;
  products?: string[];
}

const { kind, significance, products = [] } = Astro.props;

// Lucide icon paths (ISC license), drawn at 12px with currentColor.
const ICONS: Record<string, string[]> = {
  feature: [
    "M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z",
  ],
  improvement: ["M22 7 13.5 15.5 8.5 10.5 2 17", "M16 7h6v6"],
  fix: [
    "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z",
  ],
  breaking: [
    "m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3",
    "M12 9v4",
    "M12 17h.01",
  ],
  deprecation: ["M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20", "M12 6v6l4 2"],
  incident: ["M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20", "M12 8v4", "M12 16h.01"],
  release: [
    "M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z",
    "M7.5 7.5h.01",
  ],
  major: [
    "M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z",
  ],
};
---

{
  kind && (
    <span class:list={["cl-tag", "cl-kind", `cl-${kind}`]}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {(ICONS[kind] ?? []).map((d) => <path d={d} />)}
      </svg>
      {kindLabel(kind)}
    </span>
  )
}
{
  significance === "major" && (
    <span class="cl-tag cl-kind cl-major">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {ICONS.major.map((d) => <path d={d} />)}
      </svg>
      {significanceLabel("major")}
    </span>
  )
}
{
  products.map((p) => (
    <a class:list={["cl-tag", "cl-product", `cl-p-${p}`]} href={`/changelog/${p}/`}>
      {productLabel(p)}
    </a>
  ))
}

<style>
  .cl-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    white-space: nowrap;
  }

  /* custom.css underlines `.sl-markdown-content a`; tags are chips, not prose
     links. Doubled class outranks it, since Astro scopes with zero specificity. */
  a.cl-tag.cl-tag,
  a.cl-tag.cl-tag:hover {
    text-decoration: none;
  }

  .cl-tag svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cl-kind {
    --cl: var(--sl-color-gray-3);
    --cl-low: var(--sl-color-gray-6);
    --cl-high: var(--sl-color-gray-2);
    border-color: var(--cl);
    background: var(--cl-low);
    color: var(--cl-high);
    font-weight: 500;
  }

  .cl-feature {
    --cl: var(--sl-color-blue);
    --cl-low: var(--sl-color-blue-low);
    --cl-high: var(--sl-color-blue-high);
  }
  .cl-improvement {
    --cl: var(--sl-color-green);
    --cl-low: var(--sl-color-green-low);
    --cl-high: var(--sl-color-green-high);
  }
  .cl-fix,
  .cl-deprecation {
    --cl: var(--sl-color-orange);
    --cl-low: var(--sl-color-orange-low);
    --cl-high: var(--sl-color-orange-high);
  }
  .cl-breaking,
  .cl-incident {
    --cl: var(--sl-color-red);
    --cl-low: var(--sl-color-red-low);
    --cl-high: var(--sl-color-red-high);
  }
  .cl-release {
    --cl: var(--sl-color-purple);
    --cl-low: var(--sl-color-purple-low);
    --cl-high: var(--sl-color-purple-high);
  }
  .cl-major {
    --cl: var(--sl-color-accent);
    --cl-low: var(--sl-color-accent-low);
    --cl-high: var(--sl-color-accent-high);
  }
  .cl-major svg {
    fill: currentColor;
  }

  .cl-product::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--cl-dot, var(--sl-color-gray-4));
  }
  .cl-product:hover {
    border-color: var(--cl-dot, var(--sl-color-gray-3));
    color: var(--sl-color-white);
  }
  .cl-p-cloud { --cl-dot: #3b82f6; }
  .cl-p-platform { --cl-dot: #6366f1; }
  .cl-p-framework { --cl-dot: #10b981; }
  .cl-p-sdk { --cl-dot: #f59e0b; }
  .cl-p-cli { --cl-dot: #64748b; }
  .cl-p-yolop { --cl-dot: #ec4899; }
  .cl-p-mira { --cl-dot: #8b5cf6; }
  .cl-p-bashkit { --cl-dot: #14b8a6; }
</style>
