---
// Astro 6 + current starlight-openapi require newer markdown internals than
// the existing Starlight Mermaid plugin supports, so Mermaid rendering lives
// here as a bundled client script instead of a markdown-time integration.
import DefaultHead from "@astrojs/starlight/components/Head.astro";
---

<DefaultHead {...Astro.props} />

<script>
  import mermaid from "mermaid";

  const renderedAttr = "data-everruns-mermaid-source";
  let renderCount = 0;

  const currentTheme = () =>
    document.documentElement.dataset.theme === "dark" ? "dark" : "default";

  const decodeSource = (value: string) => {
    try {
      return decodeURIComponent(value);
    } catch {
      return "";
    }
  };

  const encodeSource = (value: string) => encodeURIComponent(value);

  const isPreElement = (value: Element | null): value is HTMLPreElement =>
    value instanceof HTMLPreElement;

  const prepareBlock = (
    block: HTMLPreElement,
    source: string | null | undefined
  ): HTMLPreElement | null => {
    const normalized = source?.trim() ?? "";
    if (!normalized) return null;

    if (!block.hasAttribute(renderedAttr)) {
      block.setAttribute(renderedAttr, encodeSource(normalized));
    }
    block.classList.add("expressive-code", "sl-mermaid");

    return block;
  };

  const getBlocks = (): HTMLPreElement[] => {
    const fromRenderedMarkdown = Array.from(
      document.querySelectorAll('pre[data-language="mermaid"]')
    )
      .map((block) =>
        block instanceof HTMLPreElement ? prepareBlock(block, block.textContent) : null
      )
      .filter((block): block is HTMLPreElement => block !== null);

    const fromRawCodeBlocks = Array.from(
      document.querySelectorAll("pre > code.language-mermaid")
    )
      .map((code): HTMLPreElement | null => {
        const container = code.parentElement;
        if (!isPreElement(container)) return null;
        return prepareBlock(container, code.textContent);
      })
      .filter((block): block is HTMLPreElement => block !== null);

    const rendered = Array.from(
      document.querySelectorAll(`pre[${renderedAttr}]`)
    ).filter((block): block is HTMLPreElement => block instanceof HTMLPreElement);
    return [...new Set([...fromRenderedMarkdown, ...fromRawCodeBlocks, ...rendered])];
  };

  const renderMermaid = async () => {
    const blocks = getBlocks();
    if (!blocks.length) return;

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: currentTheme(),
    });

    await Promise.all(
      blocks.map(async (block) => {
        const encoded = block.getAttribute(renderedAttr);
        const source = encoded ? decodeSource(encoded) : "";
        if (!source) return;

        try {
          const { svg, bindFunctions } = await mermaid.render(
            `everruns-mermaid-${renderCount++}`,
            source
          );

          block.innerHTML = svg;
          block.classList.add("sl-mermaid-rendered");
          bindFunctions?.(block);
        } catch (error) {
          console.error("Failed to render Mermaid diagram", error);
        }
      })
    );
  };

  const scheduleRender = () => {
    queueMicrotask(() => {
      void renderMermaid();
    });
  };

  scheduleRender();
  document.addEventListener("astro:page-load", scheduleRender);

  const themeObserver = new MutationObserver((mutations) => {
    if (
      mutations.some(
        (mutation) =>
          mutation.type === "attributes" && mutation.attributeName === "data-theme"
      )
    ) {
      scheduleRender();
    }
  });

  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
