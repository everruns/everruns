{
  "name": "@everruns/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-content": "node scripts/copy-design-tokens.mjs && node scripts/render-notebooks.mjs && node scripts/copy-openapi.mjs && node scripts/copy-agent-schema.mjs",
    "dev": "astro dev",
    "predev": "pnpm run prepare-content",
    "precheck": "node ../ui/scripts/patch-zod-v3.mjs --check && pnpm run prepare-content",
    "prebuild": "node ../ui/scripts/patch-zod-v3.mjs --check && pnpm run prepare-content && node --test integrations/changelog-media.test.mjs integrations/sitemap-enhance.test.mjs && node scripts/check-changelog.mjs && node scripts/generate-og-image.mjs",
    "build": "astro build",
    "postbuild": "node scripts/verify-notebooks.mjs && node scripts/verify-llms.mjs && node scripts/verify-seo.mjs && node scripts/verify-api-reference.mjs && node scripts/verify-fonts.mjs",
    "preview": "astro preview",
    "stage-worker": "node scripts/stage-worker-assets.mjs",
    "worker:test": "node --test worker/index.test.mjs",
    "check": "astro check",
    "release-card": "node scripts/generate-release-card.mjs",
    "release-card:test": "node --test scripts/generate-release-card.test.mjs",
    "notebooks:exec": "python3 scripts/execute-notebooks.py",
    "check:changelog": "node scripts/check-changelog.mjs",
    "sync-chrome": "node scripts/sync-site-chrome.mjs",
    "postinstall": "node ../ui/scripts/patch-zod-v3.mjs",
    "smoke:gallery": "node scripts/smoke-generative-ui-gallery.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/starlight": "^0.42.6",
    "@everruns/generative-ui": "file:../ui/generative-ui",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.2",
    "js-yaml": "^4.3.2",
    "marked": "^18.1.1",
    "mermaid": "12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "starlight-links-validator": "0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-openapi": "^0.27.0",
    "starlight-sidebar-topics": "^0.9.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "packageManager": "pnpm@10.33.0"
}
