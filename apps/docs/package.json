{
  "name": "@everruns/docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare-content": "node scripts/render-notebooks.mjs",
    "dev": "astro dev",
    "predev": "pnpm run prepare-content",
    "precheck": "pnpm run prepare-content",
    "prebuild": "pnpm run prepare-content && node scripts/generate-og-image.mjs",
    "build": "astro build",
    "postbuild": "node scripts/verify-notebooks.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "notebooks:exec": "python3 scripts/execute-notebooks.py"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.3.7",
    "js-yaml": "^4.2.0",
    "marked": "^18.0.5",
    "sharp": "^0.34.5",
    "shiki": "^4.2.0",
    "starlight-openapi": "^0.25.3",
    "starlight-sidebar-topics": "^0.7.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.17.23",
      "yaml": "2.8.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
