{
  "name": "everruns-ui",
  "version": "0.53.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "exports": {
    "./route-manifest": "./src/lib/ui-route-manifest.ts",
    "./providers/*": "./src/providers/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./lib/api/*": "./src/lib/api/*.ts",
    "./styles/*.css": "./src/app/*.css"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 9100",
    "build": "npm run typecheck && next build --turbopack",
    "start": "next start",
    "lint": "oxlint -c oxlint.json ./src",
    "format": "oxfmt --write ./src",
    "format:check": "oxfmt --check ./src",
    "api-types:generate": "node scripts/generate-api-types.mjs",
    "api-types:check": "node scripts/generate-api-types.mjs --check",
    "typecheck": "next typegen && tsrs --noEmit --fast",
    "design:lint": "pnpm exec design.md lint DESIGN.md",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "postinstall": "node scripts/patch-zod-v3.mjs",
    "pretest": "node --test scripts/test-zod-size-guards.mjs scripts/test-zod-v3-backport.mjs && npm run test:generative-ui",
    "test:generative-ui": "node --experimental-strip-types generative-ui/tests/protocol.test.ts && node generative-ui/scripts/export-catalog.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@copilotkit/core": "1.89.0",
    "@copilotkit/react-core": "1.83.0",
    "@copilotkit/shared": "1.83.0",
    "@everruns/generative-ui": "file:generative-ui",
    "@openuidev/react-headless": "^0.18.1",
    "@openuidev/react-lang": "1.1.1",
    "@openuidev/react-ui": "^0.18.1",
    "@pierre/diffs": "1.6.4",
    "@pierre/highlights": "0.5.1",
    "@pierre/words": "0.2.2",
    "@rjsf/core": "^6.11.0",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.3",
    "cronstrue": "^3.38.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.5",
    "pele": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "recharts": "^3.10.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.3",
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "6.0.3"
  }
}
