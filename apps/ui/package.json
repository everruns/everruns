{
  "name": "everruns-ui",
  "version": "0.48.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "exports": {
    "./route-manifest": "./src/lib/ui-route-manifest.ts",
    "./providers/*": "./src/providers/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./lib/api/*": "./src/lib/api/*.ts",
    "./styles/*.css": "./src/app/*.css"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 9100",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "oxlint -c oxlint.json ./src",
    "format": "oxfmt --write ./src",
    "format:check": "oxfmt --check ./src",
    "api-types:generate": "node scripts/generate-api-types.mjs",
    "api-types:check": "node scripts/generate-api-types.mjs --check",
    "typecheck": "tsgo --noEmit",
    "design:lint": "pnpm exec design.md lint DESIGN.md",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "postinstall": "node scripts/patch-zod-v3.mjs",
    "pretest": "node --test scripts/test-zod-size-guards.mjs scripts/test-zod-v3-backport.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@openuidev/react-lang": "^0.2.15",
    "@openuidev/react-ui": "^0.13.10",
    "@rjsf/core": "^6.11.0",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.32.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.0",
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
