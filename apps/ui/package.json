{
  "name": "everruns-ui",
  "version": "0.26.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "exports": {
    "./route-manifest": "./src/lib/ui-route-manifest.ts",
    "./providers/*": "./src/providers/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./lib/api/*": "./src/lib/api/*.ts",
    "./styles/*.css": "./src/app/*.css"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 9100",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "oxlint -c oxlint.json ./src",
    "format": "oxfmt --write ./src",
    "format:check": "oxfmt --check ./src",
    "api-types:generate": "node scripts/generate-api-types.mjs",
    "api-types:check": "node scripts/generate-api-types.mjs --check",
    "typecheck": "tsgo --noEmit",
    "design:lint": "pnpm exec design.md lint DESIGN.md",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@openuidev/react-lang": "^0.2.15",
    "@openuidev/react-ui": "^0.13.10",
    "@rjsf/core": "^6.8.0",
    "@rjsf/utils": "^6.8.0",
    "@rjsf/validator-ajv8": "^6.8.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "cronstrue": "^3.24.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ag-ui/core": "^0.0.59",
    "@google/design.md": "0.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
