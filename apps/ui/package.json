{
  "name": "everruns-ui",
  "version": "0.6.0",
  "private": true,
  "exports": {
    "./providers/*": "./src/providers/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./lib/api/*": "./src/lib/api/*.ts"
  },
  "scripts": {
    "dev": "next dev --port 9100",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -c oxlint.json ./src",
    "format": "oxfmt --write ./src",
    "format:check": "oxfmt --check ./src",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@streamdown/code": "^1.0.1",
    "@tanstack/react-query": "^5.90.16",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-github-blockquote-alert": "^2.0.1",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.39.0",
    "playwright": "^1.58.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
