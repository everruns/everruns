{
  "name": "everruns-ui",
  "version": "0.8.11",
  "private": true,
  "exports": {
    "./providers/*": "./src/providers/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./lib/api/*": "./src/lib/api/*.ts",
    "./styles/*.css": "./src/app/*.css"
  },
  "scripts": {
    "dev": "next dev --port 9100",
    "build": "node ./scripts/next-build.mjs",
    "start": "next start",
    "lint": "oxlint -c oxlint.json ./src",
    "format": "oxfmt --write ./src",
    "format:check": "oxfmt --check ./src",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@openuidev/react-lang": "^0.1.3",
    "@openuidev/react-ui": "^0.9.18",
    "@streamdown/code": "^1.0.3",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "remark-github-blockquote-alert": "^2.0.1",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.49.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.3"
  }
}
